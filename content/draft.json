  "process": {
    "title": {
      "fr": "Comment ça se passe",
      "en": "How it works"
    },
    "steps": [
      {
        "id": "p1",
        "title": {
          "fr": "01. Me contacter",
          "en": "01. Reach out"
        },
        "text": {
          "fr": "Remplissez le formulaire en bas de page ou écrivez-moi directement sur Instagram. Parlez-moi de votre idée, même encore floue : je réponds vite.",
          "en": "Fill in the form at the bottom of the page or DM me on Instagram. Tell me about your idea, even a rough one: I reply fast."
        }
      },
      {
        "id": "p2",
        "title": {
          "fr": "02. Échange",
          "en": "02. First chat"
        },
        "text": {
          "fr": "On discute de votre projet, vos objectifs et votre budget. Je vous propose un format et un devis clair.",
          "en": "We talk about your project, goals and budget. I come back with a format and a clear quote."
        }
      },
      {
        "id": "p3",
        "title": {
          "fr": "03. Suivi de la prestation",
          "en": "03. Project tracking"
        },
        "text": {
          "fr": "Un espace Notion partagé est mis en place dès le départ : avancement du projet, étapes validées, prochaines échéances. Vous savez toujours où on en est, pour une communication fluide.",
          "en": "A shared Notion space is set up from day one: project progress, approved steps, upcoming deadlines. You always know where we stand, for smooth communication."
        }
      },
      {
        "id": "p4",
        "title": {
          "fr": "04. Pré-production",
          "en": "04. Pre-production"
        },
        "text": {
          "fr": "Repérages, script, plan de tournage : tout est calé en amont pour un jour J sans surprise.",
          "en": "Scouting, script, shooting plan: everything is locked in ahead of time for a smooth shoot day."
        }
      },
      {
        "id": "p5",
        "title": {
          "fr": "05. Tournage",
          "en": "05. Shoot"
        },
        "text": {
          "fr": "Captation sur place, cadrage soigné, matériel adapté au lieu et à l'ambiance de votre événement.",
          "en": "On-site filming, careful framing, gear that matches the venue and the vibe of your event."
        }
      },
      {
        "id": "p6",
        "title": {
          "fr": "06. Livraison",
          "en": "06. Delivery"
        },
        "text": {
          "fr": "Montage, étalonnage, allers-retours ensemble, puis livraison dans tous les formats dont vous avez besoin.",
          "en": "Editing, grading, feedback rounds together, then delivery in every format you need."
        }
      }
    ]
  },
