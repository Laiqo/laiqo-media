  "services": [
    {
      "id": "cadrage",
      "title": {
        "fr": "Cadrage",
        "en": "Filming"
      },
      "image": null,
      "lines": [
        {
          "id": "cadrage-1",
          "label": {
            "fr": "Captation multi-caméras",
            "en": "Multi-camera coverage"
          },
          "explanation": {
            "fr": "Plusieurs caméras synchronisées pour ne rien rater et varier les angles au montage.",
            "en": "Several synced cameras so nothing is missed and every angle is covered."
          }
        },
        {
          "id": "cadrage-2",
          "label": {
            "fr": "Interviews & plateaux",
            "en": "Interviews & studio sets"
          },
          "explanation": {
            "fr": "Installation lumière et son, cadre stable et mise à l'aise des intervenants.",
            "en": "Lighting and sound setup, steady framing and relaxed interviewees."
          }
        },
        {
          "id": "cadrage-3",
          "label": {
            "fr": "Événementiel & concerts",
            "en": "Events & concerts"
          },
          "explanation": {
            "fr": "Je me fonds dans l'événement pour capter l'ambiance sans jamais gêner.",
            "en": "I blend into the event to capture the vibe without ever being in the way."
          }
        },
        {
          "id": "cadrage-4",
          "label": {
            "fr": "Images d'illustration",
            "en": "B-roll & illustration footage"
          },
          "explanation": {
            "fr": "Plans d'appui (b-roll) qui enrichissent le montage et racontent le contexte.",
            "en": "Supporting shots that enrich the edit and tell the context."
          }
        }
      ]
    },
    {
      "id": "montage",
      "title": {
        "fr": "Montage",
        "en": "Editing"
      },
      "image": null,
      "lines": [
        {
          "id": "montage-1",
          "label": {
            "fr": "Montage narratif & rythmé",
            "en": "Narrative, well-paced editing"
          },
          "explanation": {
            "fr": "Une structure claire et un rythme qui tiennent le spectateur jusqu'à la fin.",
            "en": "A clear structure and a pace that keeps viewers watching to the end."
          }
        },
        {
          "id": "montage-2",
          "label": {
            "fr": "Étalonnage",
            "en": "Color grading"
          },
          "explanation": {
            "fr": "Harmonisation des couleurs et look sur mesure pour une image cohérente.",
            "en": "Color matching and a tailored look for a consistent image."
          }
        },
        {
          "id": "montage-3",
          "label": {
            "fr": "Sound design & mixage",
            "en": "Sound design & mixing"
          },
          "explanation": {
            "fr": "Voix claires, musique équilibrée et effets sonores qui donnent du relief.",
            "en": "Clean voices, balanced music and sound effects that add depth."
          }
        },
        {
          "id": "montage-4",
          "label": {
            "fr": "Habillage & sous-titres",
            "en": "Motion graphics & subtitles"
          },
          "explanation": {
            "fr": "Titres, logos animés et sous-titres propres, prêts pour les réseaux.",
            "en": "Titles, animated logos and clean subtitles, ready for social."
          }
        }
      ]
    },
    {
      "id": "production",
      "title": {
        "fr": "Production",
        "en": "Production"
      },
      "image": null,
      "lines": [
        {
          "id": "production-1",
          "label": {
            "fr": "Conception & script",
            "en": "Concept & scripting"
          },
          "explanation": {
            "fr": "On part de votre idée pour écrire un déroulé et un message efficaces.",
            "en": "We start from your idea and write an effective outline and message."
          }
        },
        {
          "id": "production-2",
          "label": {
            "fr": "Organisation de tournage",
            "en": "Shoot planning"
          },
          "explanation": {
            "fr": "Planning, lieux, autorisations : tout est calé avant le jour J.",
            "en": "Schedule, locations, permits: everything locked before the day."
          }
        },
        {
          "id": "production-3",
          "label": {
            "fr": "Coordination d'équipe",
            "en": "Crew coordination"
          },
          "explanation": {
            "fr": "Je réunis et dirige les bonnes personnes selon la taille du projet.",
            "en": "I bring together and direct the right people for the project size."
          }
        },
        {
          "id": "production-4",
          "label": {
            "fr": "Livraison multi-formats",
            "en": "Multi-format delivery"
          },
          "explanation": {
            "fr": "Fichiers optimisés pour chaque plateforme : YouTube, réseaux, écran géant.",
            "en": "Files optimized for every platform: YouTube, social, big screen."
          }
        }
      ]
    }
